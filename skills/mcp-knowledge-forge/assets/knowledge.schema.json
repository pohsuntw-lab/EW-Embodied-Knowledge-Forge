{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "const": "ew-mcp-knowledge"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "knowledge_base_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "filename": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "extraction_status": {
            "type": "string",
            "enum": [
              "complete",
              "partial",
              "blocked"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "source_id",
          "title",
          "filename",
          "media_type",
          "extraction_status",
          "sha256",
          "warnings"
        ],
        "additionalProperties": false
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "knowledge_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "candidate",
              "approved",
              "rejected",
              "superseded",
              "withdrawn"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "content_kind": {
            "type": "string",
            "enum": [
              "source_text",
              "expert_interpretation",
              "fact",
              "proposal",
              "unresolved"
            ]
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "synonyms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "locator": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "page",
                        "paragraph",
                        "heading",
                        "lines",
                        "cells",
                        "table",
                        "timestamp",
                        "unlocated"
                      ]
                    },
                    "value": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "minLength": 1
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "source_id",
                "locator"
              ],
              "additionalProperties": false
            }
          },
          "relations": {
            "type": "object",
            "properties": {
              "up": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "uniqueItems": true
              },
              "related": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "uniqueItems": true
              },
              "replaces": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "up",
              "related",
              "replaces"
            ],
            "additionalProperties": false
          },
          "validity": {
            "type": "object",
            "properties": {
              "effective_from": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "effective_until": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              }
            },
            "required": [
              "effective_from",
              "effective_until"
            ],
            "additionalProperties": false
          },
          "legal": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "law_name": {
                "type": "string",
                "minLength": 1
              },
              "article": {
                "type": "string",
                "minLength": 1
              },
              "jurisdiction": {
                "type": "string",
                "minLength": 1
              },
              "effective_from": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "effective_until": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "verified_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              }
            },
            "required": [
              "law_name",
              "article",
              "jurisdiction",
              "effective_from",
              "effective_until",
              "verified_at"
            ],
            "additionalProperties": false
          },
          "access": {
            "type": "object",
            "properties": {
              "classification": {
                "type": "string",
                "enum": [
                  "P0",
                  "P1",
                  "P2",
                  "P3",
                  "unknown"
                ]
              },
              "audiences": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "route": {
                "type": "string",
                "enum": [
                  "cloud-approved",
                  "cloud-sanitized",
                  "local-only",
                  "blocked"
                ]
              }
            },
            "required": [
              "classification",
              "audiences",
              "route"
            ],
            "additionalProperties": false
          },
          "approval": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "approved",
                  "rejected"
                ]
              },
              "reviewer": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "reviewed_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "evidence": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              }
            },
            "required": [
              "status",
              "reviewer",
              "reviewed_at",
              "evidence"
            ],
            "additionalProperties": false
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "knowledge_id",
          "title",
          "category",
          "version",
          "status",
          "summary",
          "body",
          "content_kind",
          "keywords",
          "synonyms",
          "questions",
          "source_refs",
          "relations",
          "validity",
          "legal",
          "access",
          "approval",
          "created_at",
          "updated_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "schema_version",
    "knowledge_base_id",
    "sources",
    "records"
  ],
  "additionalProperties": false
}
